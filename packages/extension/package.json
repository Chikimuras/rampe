		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@rampe/core": "workspace:*",
		"axe-core": "4.14.0"
	},
	"devDependencies": {
		"@rampe/site": "workspace:*",
		"@types/node": "22.20.5",
		"playwright": "1.64.1",
		"vite": "8.3.4",
		"vitest": "5.0.4"
	}
}
