---
import { url } from "../lib/url";

interface Props {
	title: string;
	description?: string;
}
const { title, description = "Rampe — accompagner les PME vers la conformité RGAA." } = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<title>{title} · Rampe</title>
		<style is:global>
			:root {
				--bg: #fbfaf7;
				--surface: #ffffff;
				--text: #1c1b19;
				--muted: #5d5a53;
				--line: #e3e0d8;
				--accent: #0b5d4b;
				--accent-soft: #e2f0eb;
				--warn: #8a4b00;
				color-scheme: light dark;
			}
			@media (prefers-color-scheme: dark) {
				:root {
					--bg: #151513;
					--surface: #1e1e1b;
					--text: #ecebe6;
					--muted: #a9a69d;
					--line: #34332f;
					--accent: #6fd3b5;
					--accent-soft: #1c3a32;
					--warn: #f2b45c;
				}
			}
			* {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				background: var(--bg);
				color: var(--text);
				font: 17px/1.6 system-ui, -apple-system, "Segoe UI", sans-serif;
				/* Une adresse ou un code long ne déborde pas de l'écran étroit (critère 10.11). */
				overflow-wrap: break-word;
			}
			a {
				color: var(--accent);
				text-underline-offset: 0.2em;
			}
			:focus-visible {
				outline: 3px solid var(--accent);
				outline-offset: 2px;
			}
			.skip {
				position: absolute;
				left: -9999px;
			}
			.skip:focus {
				left: 1rem;
				top: 1rem;
				background: var(--surface);
				padding: 0.5rem 1rem;
				z-index: 1;
			}
			header,
			main,
			footer {
				max-width: 52rem;
				margin: 0 auto;
				padding: 0 1rem;
			}
			/* Navigation principale en liste (critère 9.3), affichée en ligne. */
			header nav ul {
				list-style: none;
				margin: 0;
				display: flex;
				gap: 1.25rem;
				flex-wrap: wrap;
				align-items: baseline;
				padding: 1.25rem 0;
				border-bottom: 1px solid var(--line);
			}
			header nav .brand {
				margin-right: auto;
			}
			header nav .brand a {
				font-weight: 700;
				color: var(--text);
				text-decoration: none;
			}
			main {
				padding-block: 2rem 4rem;
			}
			footer {
				color: var(--muted);
				font-size: 0.875rem;
				padding-block: 2rem;
				border-top: 1px solid var(--line);
			}
			pre {
				overflow-x: auto;
				padding: 1rem;
				background: var(--surface);
				border: 1px solid var(--line);
				border-radius: 6px;
			}
			code {
				font-size: 0.9em;
			}
			table {
				border-collapse: collapse;
			}
			th,
			td {
				border: 1px solid var(--line);
				padding: 0.4rem 0.6rem;
				text-align: left;
			}
		</style>
	</head>
	<body>
		<a class="skip" href="#contenu">Aller au contenu</a>
		<header>
			<nav aria-label="Navigation principale">
				<ul>
					<li class="brand"><a href={url()}>Rampe</a></li>
					<li><a href={url("referentiel/")}>Référentiel</a></li>
					<li><a href={url("audit/")}>Audit guidé</a></li>
					<li><a href={url("cockpit/")}>Cockpit</a></li>
					<li><a href={url("cockpit/#adr")}>ADR</a></li>
					<li><a href={url("cockpit/#journal")}>Journal</a></li>
					<li><a href="https://github.com/Chikimuras/rampe">Code</a></li>
				</ul>
			</nav>
		</header>
		<main id="contenu">
			<slot />
		</main>
		<footer>
			{/* Plan du site (critère 12.1) : en pied de page, au même endroit sur chaque page (12.4). */}
			<p><a href={url("plan-du-site/")}>Plan du site</a></p>
			<p>
				Projet construit de façon autonome par Claude (Anthropic), supervisé par Alexandre Velia. Référentiel
				RGAA © DINUM, Licence Ouverte 2.0.
			</p>
		</footer>
	</body>
</html>
