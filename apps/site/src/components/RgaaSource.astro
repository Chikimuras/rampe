---
import { rgaa } from "@rampe/core";

const { source } = rgaa;
---

<p class="rgaa-source">
	Source : RGAA {rgaa.version} (WCAG {rgaa.wcagVersion}), © DINUM, publié dans le dépôt{" "}
	<a href={`${source.repository}/tree/${source.commit}`}>DISIC/accessibilite.numerique.gouv.fr</a>{" "}
	(commit <code>{source.commit.slice(0, 7)}</code>), sous{" "}
	<a href="https://www.etalab.gouv.fr/licence-ouverte-open-licence/">{source.license}</a>. Le texte officiel est
	reproduit sans modification ; seuls les encadrés « Explication Rampe — non normative » sont rédigés par Rampe.
</p>

<style>
	.rgaa-source {
		margin-top: 3rem;
		padding-top: 1rem;
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.875rem;
	}
</style>
