---
import { type CollectionEntry, getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import { ADR_STATUS, journalTitle } from "../../../lib/labels";
import { markEnglishHtml, TECH_TERMS } from "../../../lib/lang";
import { url } from "../../../lib/url";

type Entry = CollectionEntry<"adr" | "journal" | "docs">;

export async function getStaticPaths() {
	const names = ["adr", "journal", "docs"] as const;
	const all = await Promise.all(names.map((n) => getCollection(n)));
	return all.flat().map((entry) => ({
		params: { collection: entry.collection, id: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props as { entry: Entry };
// Les listes de tâches Markdown produisent des cases à cocher désactivées sans étiquette
// (violation axe « label », critère RGAA 11.1) : on les remplace par un statut textuel.
if (!entry.rendered) throw new Error(`${entry.id} : rendu Markdown absent`);
const rendered = entry.rendered.html
	.replace(/<input type="checkbox" checked disabled>/g, '<span class="task done">Fait</span>')
	.replace(/<input type="checkbox" disabled>/g, '<span class="task todo">À faire</span>');
// Garde-fou : on contourne render() d'Astro, qui traite aussi les images locales.
// Une case restée sans étiquette ou une image non traitée doit casser le build, pas la page.
if (rendered.includes("<input") || rendered.includes("__ASTRO_IMAGE_")) {
	throw new Error(`${entry.id} : case à cocher ou image Markdown non prise en charge par le cockpit`);
}
// Jargon anglais balisé au rendu (critère 8.7), sans retoucher l’historique de docs/ (lib/lang.ts).
const html = markEnglishHtml(rendered, TECH_TERMS);
const meta =
	entry.collection === "adr"
		? `${ADR_STATUS[entry.data.status]} · ${entry.data.date.toLocaleDateString("fr-FR")} · ${entry.data.deciders}`
		: "";
// Une entrée du journal couvre toute une journée : son titre dit d’abord laquelle (critères 8.6 et 9.1).
const title = entry.collection === "journal" ? journalTitle(entry) : entry.data.title;
const source = `${entry.collection === "docs" ? "" : `${entry.collection}/`}${entry.id}.md`;
---

<Base title={title}>
	<p><a href={url("cockpit/")}>← Cockpit</a></p>
	<h1>{title}</h1>
	{meta && <p class="meta">{meta}</p>}
	<article set:html={html} />
	<p><a href={`https://github.com/Chikimuras/rampe/blob/main/docs/${source}`}>Voir la source sur GitHub</a></p>
</Base>

<style>
	.meta {
		color: var(--muted);
	}
	/* Les tableaux Markdown tiennent dans un écran étroit (375 px) en coupant les mots au besoin, plutôt que de défiler :
	   une zone qui défile devrait être atteignable au clavier, et axe ne peut pas juger le contraste des cellules
	   masquées par le défilement (audit de Rampe en 375 px, ADR-0021). */
	article :global(:is(th, td)) {
		overflow-wrap: anywhere;
		hyphens: auto;
	}
	article :global(.task-list-item) {
		list-style: none;
	}
	article :global(.task) {
		display: inline-block;
		min-width: 4.5rem;
		margin-right: 0.5rem;
		font-size: 0.8rem;
		text-align: center;
		border-radius: 999px;
		border: 1px solid var(--accent);
	}
	article :global(.task.done) {
		background: var(--accent-soft);
	}
</style>
