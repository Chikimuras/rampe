---
import { getCollection } from "astro:content";
import { rgaa } from "@rampe/core";
import { parseSessionStrict, progress } from "@rampe/core/audit-session";
import { computeConformity, formatRate } from "@rampe/core/conformity";
import sessionText from "../../../../../docs/audit-rampe/session.json?raw";
import Base from "../../layouts/Base.astro";
import { ADR_STATUS, frDate } from "../../lib/labels";
import { url } from "../../lib/url";

const byDate = <T extends { data: { date: Date } }>(a: T, b: T) => b.data.date.getTime() - a.data.date.getTime();
const adrs = (await getCollection("adr")).sort((a, b) => a.id.localeCompare(b.id));
const journal = (await getCollection("journal")).sort(byDate);
const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);

// Avancement = cases cochées de la roadmap, regroupées par titre "## Phase".
const roadmap = docs.find((d) => d.id === "roadmap")?.body ?? "";
const phases = roadmap
	.split(/^## /m)
	.slice(1)
	.map((block) => {
		const [name] = block.split("\n");
		const done = (block.match(/^- \[x\]/gim) ?? []).length;
		const total = done + (block.match(/^- \[ \]/gm) ?? []).length;
		return { name, done, total };
	});
// « En attente d’Alexandre » = tâches non faites marquées ⛔ dans la roadmap (seule source de vérité).
// Garde-fou : une tâche ⛔ mal écrite (⛔️ avec sélecteur de variante, indentée, sans intitulé…)
// ne doit jamais disparaître en silence de cette section : elle casse le build.
const blockedRe = /^- \[ \] (\S.*?)\s*⛔\uFE0F?\s*(\S.*)$/;
const blockedLines = roadmap.split(/\r?\n/).filter((l) => /^\s*[-*+]\s+\[ \]/.test(l) && l.includes("⛔"));
const unrecognized = blockedLines.filter((l) => !blockedRe.test(l));
if (unrecognized.length > 0) throw new Error(`roadmap : tâche(s) ⛔ non reconnue(s) : ${unrecognized.join(" | ")}`);
const waiting = blockedLines.map((l) => {
	const [, task, reason] = l.match(blockedRe) ?? [];
	return { task, reason };
});
// Rampe audité par Rampe (ADR-0021). Pages construites : chaque page fixe de src/pages (sans paramètre de route),
// plus les routes dynamiques : une fiche par critère, une page par ADR, entrée de journal et document.
// `pnpm audit:rampe` vérifie que ce nombre est celui des pages qu'il a construites et auditées : il échoue sinon.
// `import.meta.glob` de Vite exclut le fichier qui l'appelle : + 1 pour cette page.
const fixedPages = Object.keys(import.meta.glob("../**/*.astro")).filter((path) => !path.includes("[")).length + 1;
const builtPages = fixedPages + rgaa.criteria.length + adrs.length + journal.length + docs.length;
// Auto-évaluation : docs/audit-rampe/session.json, généré par `pnpm auto-evaluation` (vérifié en CI), relu ici avec la
// validation stricte de l'import (ADR-0016) ; un fichier invalide casse le build.
const criterionIds = rgaa.criteria.map((c) => c.id);
const autoSession = parseSessionStrict(JSON.parse(sessionText), new Set(criterionIds));
const autoTotal = progress(autoSession, rgaa.criteria).total;
const autoConformity = computeConformity(autoSession, criterionIds);
const rate = (r: number | null) => (r === null ? "sans objet" : formatRate(r));
---

<Base title="Cockpit">
	<h1>Cockpit</h1>
	<p>Tout ce qui est affiché ici est généré depuis le dossier <code>docs/</code> du dépôt, à chaque mise en production.</p>

	<section class="waiting" aria-labelledby="en-attente">
		<h2 id="en-attente">En attente d’Alexandre</h2>
		{
			waiting.length > 0 ? (
				<>
					<p>Ces tâches demandent une action humaine (compte tiers, dépense, engagement juridique). Le reste avance sans intervention.</p>
					<ul>
						{waiting.map((w) => (
							<li>
								<strong>{w.task}</strong> — {w.reason}
							</li>
						))}
					</ul>
				</>
			) : (
				<p>Rien en attente : aucune tâche de la roadmap ne demande d’action humaine.</p>
			)
		}
	</section>

	<h2 id="avancement">Avancement</h2>
	<ul class="phases">
		{
			phases.map((p) => (
				<li>
					<span>{p.name}</span>
					<progress max={p.total || 1} value={p.done} aria-label={`${p.name} : ${p.done} sur ${p.total}`} />
					<span class="count">{p.done}/{p.total}</span>
				</li>
			))
		}
	</ul>
	<p><a href={url("cockpit/docs/roadmap/")}>Voir la <span lang="en">roadmap</span> détaillée</a></p>

	<section aria-labelledby="rampe-audite">
		<h2 id="rampe-audite">Rampe audité par Rampe</h2>
		<h3><span lang="en">Gate</span> automatique</h3>
		<p>0 non-conformité automatique sur les {builtPages} pages, en clair et en sombre.</p>
		<p>
			La CI audite chaque page construite avec la CLI de Rampe en mode strict, à chaque modification : le site n’est publié
			que si ce résultat tient (<a href={url("cockpit/adr/0021-rampe-audite-rampe/")}>ADR-0021</a>).
		</p>
		<h3>Auto-évaluation des 106 critères</h3>
		<p><strong>Auto-évaluation réalisée par une IA (Claude), non certifiée : elle ne remplace pas un audit humain.</strong></p>
		<p>
			{autoTotal.total - autoTotal.remaining} évaluations sur {autoTotal.total} ({autoSession.pages.length} pages de
			l’échantillon × {criterionIds.length} critères).
		</p>
		{
			autoConformity.complete ? (
				<ul>
					<li>Taux global (critères respectés ÷ critères applicables) : {rate(autoConformity.globalRate)}</li>
					<li>Taux moyen (moyenne des taux de chaque page) : {rate(autoConformity.averageRate)}</li>
				</ul>
			) : (
				<p>Aucun taux n’est affiché tant que l’auto-évaluation n’est pas complète.</p>
			)
		}
		<p>
			<a href={url("cockpit/session.json")} download="rampe-auto-evaluation.json">Télécharger l’auto-évaluation (JSON)</a>,
			puis importez-la dans <a href={url("audit/")}>l’audit guidé</a> (champ « Importer un audit (JSON) ») pour relire
			chaque évaluation et sa justification.
		</p>
	</section>

	<h2 id="journal">Journal de bord</h2>
	<ul>
		{journal.map((j) => <li><a href={url(`cockpit/journal/${j.id}/`)}>{frDate(j.data.date)} — {j.data.title}</a></li>)}
	</ul>

	<h2 id="adr">Décisions d’architecture (ADR), dans l’ordre</h2>
	<ol class="adr">
		{
			adrs.map((a) => (
				<li>
					<a href={url(`cockpit/adr/${a.id}/`)}>{a.data.title}</a>
					<span class={`status ${a.data.status}`}>{ADR_STATUS[a.data.status]}</span>
				</li>
			))
		}
	</ol>

	<h2 id="docs">Documentation</h2>
	<ul>
		{docs.map((d) => <li><a href={url(`cockpit/docs/${d.id}/`)}>{d.data.title}</a></li>)}
	</ul>
</Base>

<style>
	.waiting {
		border: 2px solid var(--warn);
		border-radius: 6px;
		padding: 0 1rem;
		margin-bottom: 2rem;
	}
	.phases {
		list-style: none;
		padding: 0;
	}
	.phases li {
		display: grid;
		grid-template-columns: 1fr minmax(6rem, 12rem) 3.5rem;
		gap: 0.75rem;
		align-items: center;
		padding: 0.35rem 0;
	}
	progress {
		width: 100%;
		accent-color: var(--accent);
	}
	.count {
		color: var(--muted);
		font-variant-numeric: tabular-nums;
		text-align: right;
	}
	.adr li {
		padding: 0.2rem 0;
	}
	.status {
		font-size: 0.8rem;
		margin-left: 0.5rem;
		padding: 0.05rem 0.45rem;
		border-radius: 999px;
		background: var(--accent-soft);
	}
	.status.Proposed,
	.status.Superseded,
	.status.Deprecated,
	.status.Rejected {
		background: transparent;
		border: 1px solid var(--warn);
		color: var(--warn);
	}
</style>
