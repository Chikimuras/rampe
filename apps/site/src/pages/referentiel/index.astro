---
import { criteriaWithDirectRule, rgaa, topicIntros } from "@rampe/core";
import axe from "axe-core";
import RampeNote from "../../components/RampeNote.astro";
import RgaaSource from "../../components/RgaaSource.astro";
import Base from "../../layouts/Base.astro";
import { axeVersion, rulesFor } from "../../lib/axe-rules";
import { renderMarkdown } from "../../lib/render";
import { url } from "../../lib/url";

const plural = (n: number, word: string) => `${n} ${word}${n > 1 ? "s" : ""}`;
// Seules les vérifications directes (`isDirectCheck`) comptent comme couverture : les règles à confirmer
// et les indirectes sont un signal faible (ADR-0002). Même décompte que la CLI (`criteriaWithDirectRule`).
const axeSummary = (id: string) => {
	const { direct, unconfirmed, indirect } = rulesFor(id);
	const all = [...direct, ...unconfirmed, ...indirect];
	const flags = [
		all.some((r) => r.bestPractice) && "bonne pratique d’axe",
		all.some((r) => r.experimental) && "règle expérimentale",
	].filter(Boolean);
	return [
		direct.length > 0
			? `${plural(direct.length, "règle")} axe-core directe${direct.length > 1 ? "s" : ""}`
			: "Aucune règle directe : vérification humaine indispensable",
		unconfirmed.length > 0 && `${plural(unconfirmed.length, "règle")} à confirmer (bonne pratique ou expérimentale)`,
		indirect.length > 0 &&
			`${plural(indirect.length, "règle")} indirecte${indirect.length > 1 ? "s" : ""} (signal faible)`,
		flags.length > 0 && `dont ${flags.join(", ")}`,
	]
		.filter(Boolean)
		.join(" ; ");
};
const covered = criteriaWithDirectRule(axe.getRules().map((r) => r.tags)).size;
const topics = rgaa.topics.map((t) => ({ ...t, criteria: rgaa.criteria.filter((c) => c.topic === t.number) }));
---

<Base
	title="Référentiel RGAA"
	description={`Les ${rgaa.criteria.length} critères du RGAA ${rgaa.version}, par thématique, avec ce que l’audit automatique peut en détecter.`}
>
	<h1>Référentiel RGAA {rgaa.version}</h1>
	<p>
		Le RGAA compte {rgaa.criteria.length} critères, répartis en {rgaa.topics.length} thématiques. Chaque critère est
		affiché avec son texte officiel, ses tests et leur méthodologie ; les termes techniques y renvoient au{" "}
		<a href={url("referentiel/glossaire/")}>glossaire du RGAA</a>.
	</p>
	<p>
		Pour chaque critère, on indique combien de règles d’axe-core {axeVersion} lui sont rattachées. Une règle
		« directe » cite un test RGAA du critère, sans être une bonne pratique ni une règle expérimentale d’axe :{" "}
		{covered} critères sur {rgaa.criteria.length} en ont au moins une ; les {rgaa.criteria.length - covered} autres
		n’ont aucune vérification automatique directe. Une règle « à confirmer » cite un test mais relève des bonnes
		pratiques ou des règles expérimentales d’axe ; une règle « indirecte » ne partage avec le critère qu’un critère
		WCAG : ce sont des signaux faibles, pas des vérifications.
		Même directe, une règle repère seulement certaines erreurs ; elle ne suffit jamais à déclarer un critère conforme.
	</p>
	<p>
		Pour évaluer vous-même chaque critère sur les pages de votre site, suivez l’<a href={url("audit/")}>audit guidé</a>.
	</p>

	<nav aria-labelledby="sommaire">
		<h2 id="sommaire">Thématiques</h2>
		<ol class="toc">
			{topics.map((t) => <li><a href={`#thematique-${t.number}`}>{t.title}</a></li>)}
		</ol>
	</nav>

	{
		topics.map((t) => (
			<section aria-labelledby={`thematique-${t.number}`}>
				<h2 id={`thematique-${t.number}`}>
					{t.number}. {t.title}
				</h2>
				<RampeNote>{topicIntros[t.number]}</RampeNote>
				<ul class="criteria">
					{t.criteria.map((c) => (
						<li>
							<a href={url(`referentiel/${c.id.replace(".", "-")}/`)}>
								<span class="num">Critère {c.id}</span>
								<span set:html={renderMarkdown(c.title, { inline: true, stripLinks: true })} />
							</a>
							<span class="axe">{axeSummary(c.id)}</span>
						</li>
					))}
				</ul>
			</section>
		))
	}

	<RgaaSource />
</Base>

<style>
	.toc {
		columns: 2 14rem;
		padding-left: 1.5rem;
	}
	section {
		margin-top: 2.5rem;
	}
	.criteria {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.criteria li {
		padding: 0.75rem 0;
		border-top: 1px solid var(--line);
	}
	.criteria a {
		display: block;
	}
	.num {
		font-weight: 600;
		margin-right: 0.5rem;
	}
	.axe {
		display: block;
		color: var(--muted);
		font-size: 0.875rem;
	}
</style>
