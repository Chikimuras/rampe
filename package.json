{
	"name": "rampe-depot",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@9.3.0",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm -r --if-present test",
		"build": "pnpm -r build",
		"check": "pnpm lint && pnpm typecheck && pnpm test",
		"rampe": "node packages/cli/src/cli.ts",
		"audit:rampe": "node scripts/audit-rampe.mjs",
		"auto-evaluation": "node scripts/auto-evaluation.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"typescript": "^6.0.3",
		"vnu-jar": "26.10.11"
	},
	"pnpm": {
		"neverBuiltDependencies": [
			"vnu-jar"
		]
	}
}
